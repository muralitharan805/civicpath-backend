# ==============================================================================
# CivicPath Backend - Environment Configuration Template
# ==============================================================================

# Application execution port
PORT=3000

# Application environment mode (development | staging | production)
NODE_ENV=development

# JWT Authentication Secret Key (REQUIRED: Set strong random secret in production)
JWT_SECRET=civicpath_super_secret_jwt_key_2026

# JWT Token Expiration Duration (e.g. 1d, 7d, 15m)
JWT_EXPIRES_IN=1d

# Database connection host (For containerized runtime: host.docker.internal or pgvector-db)
DB_HOST=host.docker.internal

# Database port (Default PostgreSQL: 5432)
DB_PORT=5432

# Database admin username
DB_USERNAME=vector_admin

# Database user password (REQUIRED: Replace with your actual password)
DB_PASSWORD=your_db_password_here

# PostgreSQL database name
DB_DATABASE=vectordb

# Prisma PostgreSQL connection URL string
DATABASE_URL=postgresql://vector_admin:your_db_password_here@host.docker.internal:5432/vectordb?schema=public

# Redis connection host
REDIS_HOST=redis-dev

# Redis connection port (Default: 6379)
REDIS_PORT=6379

# Redis authentication password (leave empty if no authentication is set)
REDIS_PASSWORD=

# Redis database index (Default: 0)
REDIS_DB=0

# Redis cache key prefix
REDIS_KEY_PREFIX=civicpath:

# Docker external network name for database container
DB_NETWORK_NAME=pgvector_network

# Docker external network name for Redis container
REDIS_NETWORK_NAME=redis_default

# Pre-built Docker Hub registry image tag (Optional, for remote deployments)
DOCKER_REGISTRY_IMAGE=seyalicraft/civicpath-backend:latest
